NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_IDS=
# App’s own origin in the browser. Local dev: http://localhost:3000 is fine.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Public HTTPS origin used ONLY in LINE Flex / slip links. When you run the API on
# localhost, set this to your deployed site so buttons open Vercel, not ngrok/localhost.
# Example: INVOICE_PUBLIC_BASE_URL=https://your-app.vercel.app
# INVOICE_PUBLIC_BASE_URL=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_PAYMENT_LIFF_ID=
NEXT_PUBLIC_ADMIN_LIFF_ID=
NEXT_PUBLIC_METER_LIFF_ID=
# Separate LIFF app for staff self-registration (no meter permission required)
NEXT_PUBLIC_METER_STAFF_REGISTER_LIFF_ID=
# Legacy bootstrap allowlist (optional — active staff in DB line_meter_users are used instead)
LINE_METER_USER_IDS=
LINE_METER_WEBHOOK_CHANNEL_SECRET=
LINE_METER_CHANNEL_ACCESS_TOKEN=
LINE_SLIP_NOTIFY_CHANNEL_ACCESS_TOKEN=
